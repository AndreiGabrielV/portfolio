---
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

import { ClientRouter } from 'astro:transitions'
import Analytics from '@vercel/analytics/astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts'

export interface Props {
	title?: string
	description?: string
	lang?: string
	background?: string
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	lang = 'es',
	background = 'bg-gray-950'
} = Astro.props
---

<!doctype html>
<html lang={lang} class="dark">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-NV3THZ3PKM"></script>
		<script>
			window.dataLayer = window.dataLayer || []
			function gtag() {
				dataLayer.push(arguments)
			}
			gtag('js', new Date())

			gtag('config', 'G-NV3THZ3PKM')
		</script>
		<BaseHead title={title} description={description} lang={lang} />
		<ClientRouter />
		<Analytics />
	</head>
	<body class={`${background} flex min-h-screen flex-col font-sans text-gray-100`}>
		<Header />

		<main class="flex-grow pt-16">
			<slot />
		</main>

		<Footer background={background} />
	</body>
</html>
